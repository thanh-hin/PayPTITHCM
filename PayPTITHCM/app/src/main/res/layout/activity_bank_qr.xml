<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_gray">

    <!-- ===== HEADER ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_header"
        android:padding="20dp"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🏦 Chuyển khoản ngân hàng"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tvQrAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 đ"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginTop="6dp"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ===== QR CODE ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_card"
                android:elevation="3dp"
                android:padding="20dp"
                android:layout_marginBottom="12dp">

                <ImageView
                    android:id="@+id/ivQrCode"
                    android:layout_width="240dp"
                    android:layout_height="240dp"
                    android:scaleType="fitCenter"/>

                <TextView
                    android:id="@+id/tvCountdown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mã QR hết hạn sau: 15:00"
                    android:textSize="13sp"
                    android:textColor="@color/ptit_red"
                    android:textStyle="bold"
                    android:layout_marginTop="12dp"/>
            </LinearLayout>

            <!-- ===== THÔNG TIN TÀI KHOẢN ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:elevation="3dp"
                android:padding="16dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Thông tin chuyển khoản"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_main"
                    android:layout_marginBottom="12dp"/>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@color/divider" android:layout_marginBottom="12dp"/>

                <!-- Ngân hàng -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:paddingVertical="6dp">
                    <TextView android:layout_width="120dp" android:layout_height="wrap_content"
                        android:text="Ngân hàng" android:textSize="13sp" android:textColor="@color/text_hint"/>
                    <TextView android:id="@+id/tvBankName" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1"
                        android:textSize="13sp" android:textColor="@color/text_main" android:textStyle="bold"/>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@color/divider"/>

                <!-- Số tài khoản -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:paddingVertical="6dp">
                    <TextView android:layout_width="120dp" android:layout_height="wrap_content"
                        android:text="Số TK" android:textSize="13sp" android:textColor="@color/text_hint"/>
                    <TextView android:id="@+id/tvAccountNo" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1"
                        android:textSize="15sp" android:textColor="@color/ptit_red"
                        android:textStyle="bold" android:letterSpacing="0.05"/>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@color/divider"/>

                <!-- Chủ tài khoản -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:paddingVertical="6dp">
                    <TextView android:layout_width="120dp" android:layout_height="wrap_content"
                        android:text="Chủ TK" android:textSize="13sp" android:textColor="@color/text_hint"/>
                    <TextView android:id="@+id/tvAccountName" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1"
                        android:textSize="13sp" android:textColor="@color/text_main"/>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@color/divider"/>

                <!-- Nội dung -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:paddingVertical="6dp">
                    <TextView android:layout_width="120dp" android:layout_height="wrap_content"
                        android:text="Nội dung CK" android:textSize="13sp" android:textColor="@color/text_hint"/>
                    <TextView android:id="@+id/tvTransferContent" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1"
                        android:textSize="13sp" android:textColor="@color/text_main"
                        android:textStyle="bold"/>
                </LinearLayout>

            </LinearLayout>

            <!-- Warning note -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="#FFF3CD"
                android:padding="12dp"
                android:layout_marginBottom="16dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚠️ "
                    android:textSize="14sp"/>
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Vui lòng chuyển đúng số tiền và nội dung để hệ thống tự động xác nhận."
                    android:textSize="12sp"
                    android:textColor="#856404"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- ===== BUTTONS ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:background="@color/white"
        android:elevation="8dp">

        <Button
            android:id="@+id/btnCancelQR"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginEnd="10dp"
            android:text="Huỷ"
            android:textAllCaps="false"
            android:textSize="15sp"
            android:background="@drawable/bg_button_secondary"
            android:textColor="@color/text_sub"
            android:stateListAnimator="@null"/>

        <Button
            android:id="@+id/btnConfirmTransfer"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="2"
            android:text="✅ Đã chuyển khoản"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textSize="14sp"
            android:background="@drawable/bg_button_primary"
            android:textColor="#FFFFFF"
            android:stateListAnimator="@null"/>
    </LinearLayout>

</LinearLayout>
