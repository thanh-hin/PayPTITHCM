<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/bg_gray">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ===== HEADER ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_login_header"
            android:paddingBottom="20dp">

            <ImageView
                android:id="@+id/imgLogo"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@drawable/logo_ptit"
                android:scaleType="fitCenter"
                android:background="@drawable/bg_icon_circle"
                android:padding="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PAY PTITHCM"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:layout_marginTop="10dp"/>
        </LinearLayout>

        <!-- ===== FORM ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginTop="-30dp"
            android:padding="24dp"
            android:elevation="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Đăng nhập"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/text_main"
                android:layout_marginBottom="16dp"/>

            <!-- MSSV -->
            <EditText
                android:id="@+id/etMSSV"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="MSSV (VD: 21520001)"
                android:text="21520001"
                android:background="@drawable/bg_input"
                android:paddingHorizontal="16dp"
                android:layout_marginBottom="12dp"
                android:inputType="text"/>

            <!-- Password -->
            <EditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="Mật khẩu"
                android:text="21520001"
                android:background="@drawable/bg_input"
                android:paddingHorizontal="16dp"
                android:layout_marginBottom="16dp"
                android:inputType="textPassword"/>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#EEE" android:layout_marginBottom="16dp"/>

            <!-- KHU VỰC HIỂN THỊ OTP (CỰC KỲ RÕ RÀNG) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="16dp"
                android:background="#15CE0707"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MÃ OTP CỦA BẠN"
                    android:textSize="11sp"
                    android:textColor="@color/ptit_red"
                    android:textStyle="bold"
                    android:alpha="0.7"/>

                <TextView
                    android:id="@+id/tvGeneratedOtp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BẤM NÚT DƯỚI ĐỂ LẤY MÃ"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/ptit_red"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>

            <Button
                android:id="@+id/btnSendOtp"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:text="GỬI MÃ OTP"
                android:background="@drawable/bg_otp"
                android:textColor="@color/ptit_red"
                android:layout_marginBottom="16dp"
                android:stateListAnimator="@null"/>

            <EditText
                android:id="@+id/etTotp"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:hint="Nhập 6 số vừa thấy ở trên"
                android:background="@drawable/bg_input"
                android:paddingHorizontal="16dp"
                android:layout_marginBottom="24dp"
                android:inputType="number"
                android:gravity="center"
                android:textSize="20sp"
                android:letterSpacing="0.2"/>

            <Button
                android:id="@+id/btnLogin"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="ĐĂNG NHẬP"
                android:textStyle="bold"
                android:background="@drawable/bg_button_primary"
                android:textColor="#FFFFFF"
                android:textSize="16sp"/>

            <TextView
                android:id="@+id/tvHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="💡 Đã điền sẵn tài khoản mẫu để bạn test nhanh."
                android:textSize="12sp"
                android:textColor="@color/text_hint"
                android:gravity="center"
                android:layout_marginTop="20dp"/>
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="40dp"/>
    </LinearLayout>
</ScrollView>
